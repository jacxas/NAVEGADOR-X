# GEMINI_API_KEY: credencial de Gemini para la edición web.
# Sin ella el servidor arranca igual y responde desde el motor local offline.
# Se lee del entorno del proceso: no se escribe en disco ni se envía al cliente.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde se publica la aplicación (enlaces propios y callbacks OAuth).
APP_URL="MY_APP_URL"

# NAVEGADOR_HOST: interfaz de escucha del servidor.
#   - Sin definir o 127.0.0.1 → solo accesible desde este equipo (recomendado).
#   - 0.0.0.0 → acepta conexiones de la red local. Solo si sabes que lo quieres.
NAVEGADOR_HOST="127.0.0.1"

# PORT: puerto del servidor. Por defecto 3000.
PORT=3000
